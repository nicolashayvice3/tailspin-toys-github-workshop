---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'span'>, 'color'> {
    /** Color theme for the tag. */
    color?: 'blue' | 'purple';
    /** Optional link destination to render the tag as an anchor. */
    href?: string;
}

const { color = 'blue', class: className, href, ...rest } = Astro.props;

const colors: Record<NonNullable<Props['color']>, string> = {
    blue: 'bg-blue-900/60 text-blue-300',
    purple: 'bg-purple-900/60 text-purple-300',
};

const classes = ['text-xs font-medium px-2.5 py-0.5 rounded', colors[color], className];
---

{href ? (
    <a href={href} class:list={classes} {...rest}>
        <slot />
    </a>
) : (
    <span class:list={classes} {...rest}>
        <slot />
    </span>
)}
