---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers, getCatalogSummary } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const catalogSummary = await getCatalogSummary(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section
      class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/80 p-6 shadow-lg"
      data-testid="catalog-summary"
      aria-labelledby="catalog-summary-title"
    >
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-sky-300">Catalog overview</p>
          <h2 id="catalog-summary-title" class="mt-2 text-2xl font-semibold text-slate-100" data-testid="catalog-summary-title">
            Catalog summary
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-slate-700 bg-slate-900/60 p-4" data-testid="catalog-summary-total">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-400">Total games</p>
            <p class="mt-3 text-3xl font-bold text-slate-100">{catalogSummary.totalGames}</p>
            <p class="mt-1 text-sm text-slate-300">games in the catalog</p>
          </div>

          <div class="rounded-xl border border-slate-700 bg-slate-900/60 p-4" data-testid="catalog-summary-average">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-400">Average rating</p>
            <p class="mt-3 text-3xl font-bold text-slate-100">
              {catalogSummary.averageStarRating === null ? '—' : catalogSummary.averageStarRating.toFixed(1)}
            </p>
            <p class="mt-1 text-sm text-slate-300">
              {catalogSummary.averageStarRating === null ? 'No rated games yet' : 'out of 5 stars'}
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg">
      <form class="space-y-5" data-testid="game-filters" aria-label="Filter games">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1" data-testid="category-filter-group">
            <legend class="mb-3 block text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-blue-500/60 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 focus-within:ring-offset-slate-900"
                  for={`category-filter-${category.id}`}
                >
                  <input
                    id={`category-filter-${category.id}`}
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 accent-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="min-w-[220px]">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
              data-testid="publisher-filter"
              aria-label="Filter by publisher"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-100 transition-colors duration-200 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-testid="clear-filters-button"
          >
            Clear filters
          </button>
          <p class="text-sm text-slate-400" data-testid="results-summary" role="status" aria-live="polite">
            {games.length} games
          </p>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => (
              <GameCard game={game} />
            ))}
          </div>
          <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-8 text-center text-slate-200" data-testid="filter-empty-state" hidden>
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="category"][type="checkbox"]'),
  );
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const resultsSummary = document.querySelector<HTMLElement>('[data-testid="results-summary"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  function getSelectedCategoryIds(): number[] {
    return categoryInputs.filter((input) => input.checked).map((input) => Number(input.value));
  }

  function getSelectedPublisherIds(): number[] {
    if (!publisherFilter || !publisherFilter.value) {
      return [];
    }

    return [Number(publisherFilter.value)];
  }

  function applyFilters() {
    const selectedCategoryIds = getSelectedCategoryIds();
    const selectedPublisherIds = getSelectedPublisherIds();
    let visibleCount = 0;

    gameCards.forEach((card) => {
      const categoryIdValue = card.getAttribute('data-category-id');
      const publisherIdValue = card.getAttribute('data-publisher-id');
      const categoryId = categoryIdValue === null || categoryIdValue === '' ? null : Number(categoryIdValue);
      const publisherId = publisherIdValue === null || publisherIdValue === '' ? null : Number(publisherIdValue);

      const matchesCategory =
        selectedCategoryIds.length === 0 ||
        (categoryId !== null && selectedCategoryIds.includes(categoryId));
      const matchesPublisher =
        selectedPublisherIds.length === 0 ||
        (publisherId !== null && selectedPublisherIds.includes(publisherId));
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }

    if (resultsSummary) {
      resultsSummary.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    }
  }

  categoryInputs.forEach((input) => input.addEventListener('change', applyFilters));

  if (publisherFilter) {
    publisherFilter.addEventListener('change', applyFilters);
  }

  if (clearFiltersButton) {
    clearFiltersButton.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });

      if (publisherFilter) {
        publisherFilter.value = '';
      }

      applyFilters();
    });
  }

  applyFilters();
</script>
