---
import Layout from '../layouts/Layout.astro';
import GameCatalog from '../components/GameCatalog.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllPublishers, getCatalogSummary, getPaginatedGames } from '../lib/games';
import { DEFAULT_PAGE_SIZE } from '../lib/pagination';

export const prerender = true;

const db = getDatabase();
const pagination = await getPaginatedGames(db, { page: 1, pageSize: DEFAULT_PAGE_SIZE });
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
const catalogSummary = await getCatalogSummary(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <GameCatalog
      games={pagination.items}
      categories={categories}
      publishers={publishers}
      catalogSummary={catalogSummary}
      pagination={pagination}
    />
  </div>
</Layout>
