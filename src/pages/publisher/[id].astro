---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import GameCard from '../../components/GameCard.astro';
import Button from '../../components/Button.astro';
import ArrowLeft from '../../assets/icons/arrow-left.svg';
import { getDatabase } from '../../lib/db';
import { getAllPublisherIds, getGamesByPublisherId, getPublisherById } from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
    const ids = await getAllPublisherIds(getDatabase());
    return ids.map((id) => ({ params: { id: String(id) } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const publisher = await getPublisherById(getDatabase(), Number(id));

if (!publisher) {
    return Astro.redirect('/404');
}

const games = await getGamesByPublisherId(getDatabase(), publisher.id);
---

<Layout title={`${publisher.name} - Tailspin Toys`}>
  <div class="py-8" data-testid="publisher-page">
    <PageHero title={publisher.name} subtitle={`Explore games from ${publisher.name}.`} />

    {publisher.description && (
      <p class="text-slate-300 mb-8" data-testid="publisher-description">{publisher.description}</p>
    )}

    {games.length === 0 ? (
      <EmptyState text={`No games published by ${publisher.name} yet.`} />
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="publisher-games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    )}

    <div class="mt-8">
      <Button href="/" size="sm" data-testid="publisher-back-home-link">
        <ArrowLeft class="h-5 w-5 mr-2" aria-hidden="true" />
        Back to all games
      </Button>
    </div>
  </div>
</Layout>
